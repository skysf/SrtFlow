{
 "components": {
  "schemas": {
   "File": {
    "properties": {
     "content_type": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The mime type of the file.",
      "examples": [
       "image/png"
      ],
      "title": "Content Type"
     },
     "file_name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The name of the file. It will be auto-generated if not provided.",
      "examples": [
       "z9RV14K95DvU.png"
      ],
      "title": "File Name"
     },
     "file_size": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "The size of the file in bytes.",
      "examples": [
       4404019
      ],
      "title": "File Size"
     },
     "url": {
      "description": "The URL where the file can be downloaded from.",
      "title": "Url",
      "type": "string"
     }
    },
    "required": [
     "url"
    ],
    "title": "File",
    "type": "object",
    "x-fal-order-properties": [
     "url",
     "content_type",
     "file_name",
     "file_size"
    ]
   },
   "QueueStatus": {
    "properties": {
     "cancel_url": {
      "description": "The cancel url.",
      "type": "string"
     },
     "logs": {
      "additionalProperties": true,
      "description": "The logs.",
      "type": "object"
     },
     "metrics": {
      "additionalProperties": true,
      "description": "The metrics.",
      "type": "object"
     },
     "queue_position": {
      "description": "The queue position.",
      "type": "integer"
     },
     "request_id": {
      "description": "The request id.",
      "type": "string"
     },
     "response_url": {
      "description": "The response url.",
      "type": "string"
     },
     "status": {
      "enum": [
       "IN_QUEUE",
       "IN_PROGRESS",
       "COMPLETED"
      ],
      "type": "string"
     },
     "status_url": {
      "description": "The status url.",
      "type": "string"
     }
    },
    "required": [
     "status",
     "request_id"
    ],
    "type": "object"
   },
   "Zonos2Input": {
    "properties": {
     "accurate_mode": {
      "default": true,
      "description": "True = closer voice match; False = more expressive.",
      "title": "Accurate Mode",
      "type": "boolean"
     },
     "clean_speaker_background": {
      "default": false,
      "description": "Mark the reference audio as having a clean background.",
      "title": "Clean Speaker Background",
      "type": "boolean"
     },
     "language": {
      "default": "en_us",
      "description": "Text-normalization language code. Supported: en_us, en_gb, fr_fr, de, es, it, pt_br, ja, cmn, ko. Unsupported codes skip normalization.",
      "examples": [
       "en_us"
      ],
      "title": "Language",
      "type": "string"
     },
     "max_tokens": {
      "anyOf": [
       {
        "maximum": 6144,
        "minimum": 1,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "Maximum number of audio frames to generate. Defaults to the model context limit.",
      "title": "Max Tokens"
     },
     "min_p": {
      "default": 0.18,
      "description": "Minimum-probability sampling threshold.",
      "maximum": 1,
      "minimum": 0,
      "title": "Min P",
      "type": "number"
     },
     "reference_audio_url": {
      "description": "Reference audio to clone the voice from.",
      "examples": [
       "https://storage.googleapis.com/falserverless/model_tests/zonos/demo_voice_zonos.wav"
      ],
      "title": "Reference Audio Url",
      "type": "string"
     },
     "seed": {
      "anyOf": [
       {
        "maximum": 2147483647,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "Seed for reproducibility. Random when omitted.",
      "title": "Seed"
     },
     "temperature": {
      "default": 1.15,
      "description": "Sampling temperature.",
      "maximum": 2,
      "minimum": 0,
      "title": "Temperature",
      "type": "number"
     },
     "text": {
      "default": "\"Fal\" is the fastest solution for your audio generation.",
      "description": "Text to synthesize in the cloned voice.",
      "examples": [
       "\"Fal\" is the fastest solution for your audio generation."
      ],
      "title": "Text",
      "type": "string"
     },
     "top_k": {
      "default": 106,
      "description": "Top-k sampling cutoff (0 disables).",
      "maximum": 2048,
      "minimum": 0,
      "title": "Top K",
      "type": "integer"
     },
     "top_p": {
      "default": 0,
      "description": "Nucleus sampling probability (0 disables).",
      "maximum": 1,
      "minimum": 0,
      "title": "Top P",
      "type": "number"
     }
    },
    "required": [
     "reference_audio_url"
    ],
    "title": "Zonos2Input",
    "type": "object",
    "x-fal-order-properties": [
     "reference_audio_url",
     "text",
     "language",
     "seed",
     "accurate_mode",
     "clean_speaker_background",
     "temperature",
     "top_p",
     "min_p",
     "top_k",
     "max_tokens"
    ]
   },
   "Zonos2Output": {
    "properties": {
     "audio": {
      "$ref": "#/components/schemas/File",
      "description": "The generated audio (WAV, 44.1kHz mono)."
     },
     "seed": {
      "description": "The seed used for generation.",
      "title": "Seed",
      "type": "integer"
     }
    },
    "required": [
     "audio",
     "seed"
    ],
    "title": "Zonos2Output",
    "type": "object",
    "x-fal-order-properties": [
     "audio",
     "seed"
    ]
   }
  },
  "securitySchemes": {
   "apiKeyAuth": {
    "description": "Fal Key",
    "in": "header",
    "name": "Authorization",
    "type": "apiKey"
   }
  }
 },
 "info": {
  "description": "Zonos 2 is an open-source, real-time text-to-speech model from Zyphra that creates natural, expressive speech and clones a voice from just a short audio sample. Give it a few seconds of reference audio plus a line of text, and it speaks that text back in the cloned voice.",
  "title": "Queue OpenAPI for fal-ai/zonos2",
  "version": "1.0.0",
  "x-fal-metadata": {
   "about": "Voice Cloning",
   "category": "text-to-speech",
   "documentationUrl": "https://fal.ai/models/fal-ai/zonos2/api",
   "endpointId": "fal-ai/zonos2",
   "playgroundUrl": "https://fal.ai/models/fal-ai/zonos2",
   "thumbnailUrl": "https://v3b.fal.media/files/b/0a9e7f9a/QwGx_S5uNbkzNRXsMZpDw_c64a2dc8166b4688a78bc80bfdb53ed0.jpg"
  }
 },
 "openapi": "3.0.4",
 "paths": {
  "/fal-ai/zonos2": {
   "post": {
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Zonos2Input"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/QueueStatus"
        }
       }
      },
      "description": "The request status."
     }
    }
   }
  },
  "/fal-ai/zonos2/requests/{request_id}": {
   "get": {
    "parameters": [
     {
      "in": "path",
      "name": "request_id",
      "required": true,
      "schema": {
       "description": "Request ID",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Zonos2Output"
        }
       }
      },
      "description": "Result of the request."
     }
    }
   }
  },
  "/fal-ai/zonos2/requests/{request_id}/cancel": {
   "put": {
    "parameters": [
     {
      "in": "path",
      "name": "request_id",
      "required": true,
      "schema": {
       "description": "Request ID",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "properties": {
          "success": {
           "description": "Whether the request was cancelled successfully.",
           "type": "boolean"
          }
         },
         "type": "object"
        }
       }
      },
      "description": "The request was cancelled."
     }
    }
   }
  },
  "/fal-ai/zonos2/requests/{request_id}/status": {
   "get": {
    "parameters": [
     {
      "in": "path",
      "name": "request_id",
      "required": true,
      "schema": {
       "description": "Request ID",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "logs",
      "required": false,
      "schema": {
       "description": "Whether to include logs (`1`) in the response or not (`0`).",
       "type": "number"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/QueueStatus"
        }
       }
      },
      "description": "The request status."
     }
    }
   }
  }
 },
 "security": [
  {
   "apiKeyAuth": []
  }
 ],
 "servers": [
  {
   "url": "https://queue.fal.run"
  }
 ]
}
