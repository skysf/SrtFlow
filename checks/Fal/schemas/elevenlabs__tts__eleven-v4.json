 },
 "info": {
  "description": "Convert text into speech with Eleven v4 from ElevenLabs.\n\nChoose a voice and adjust stability and similarity to shape delivery. Use audio tags such as [whispering] and IPA pronunciation enclosed in forward slashes.\n\nSupports up to 5,000 characters per request, language selection, text normalization, an optional seed for best-effort reproducibility, and optional timestamps. Choose from MP3, PCM, Opus, mu-law, and A-law output formats.",
  "title": "Queue OpenAPI for elevenlabs/tts/eleven-v4",
  "version": "1.0.0",
  "x-fal-metadata": {
   "about": "Eleven V4",
   "category": "text-to-speech",
   "documentationUrl": "https://fal.ai/models/elevenlabs/tts/eleven-v4/api",
   "endpointId": "elevenlabs/tts/eleven-v4",
   "playgroundUrl": "https://fal.ai/models/elevenlabs/tts/eleven-v4",
   "thumbnailUrl": "https://v3b.fal.media/files/b/0aac4241/SUZvoStueCW3Z6uEtzMiA.jpg"
  }
 },
