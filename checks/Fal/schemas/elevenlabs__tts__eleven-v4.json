{
 "components": {
  "schemas": {
   "File": {
    "properties": {
     "content_type": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The mime type of the file.",
      "examples": [
       "image/png"
      ],
      "title": "Content Type"
     },
     "file_name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The name of the file. It will be auto-generated if not provided.",
      "examples": [
       "z9RV14K95DvU.png"
      ],
      "title": "File Name"
     },
     "file_size": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "The size of the file in bytes.",
      "examples": [
       4404019
      ],
      "title": "File Size"
     },
     "url": {
      "description": "The URL where the file can be downloaded from.",
      "title": "Url",
      "type": "string"
     }
    },
    "required": [
     "url"
    ],
    "title": "File",
    "type": "object",
    "x-fal-order-properties": [
     "url",
     "content_type",
     "file_name",
     "file_size"
    ]
   },
   "QueueStatus": {
    "properties": {
     "cancel_url": {
      "description": "The cancel url.",
      "type": "string"
     },
     "logs": {
      "additionalProperties": true,
      "description": "The logs.",
      "type": "object"
     },
     "metrics": {
      "additionalProperties": true,
      "description": "The metrics.",
      "type": "object"
     },
     "queue_position": {
      "description": "The queue position.",
      "type": "integer"
     },
     "request_id": {
      "description": "The request id.",
      "type": "string"
     },
     "response_url": {
      "description": "The response url.",
      "type": "string"
     },
     "status": {
      "enum": [
       "IN_QUEUE",
       "IN_PROGRESS",
       "COMPLETED"
      ],
      "type": "string"
     },
     "status_url": {
      "description": "The status url.",
      "type": "string"
     }
    },
    "required": [
     "status",
     "request_id"
    ],
    "type": "object"
   },
   "TtsElevenV4Input": {
    "properties": {
     "apply_text_normalization": {
      "default": "auto",
      "description": "Whether to normalize text such as numbers and dates before generation.",
      "enum": [
       "auto",
       "on",
       "off"
      ],
      "title": "Apply Text Normalization",
      "type": "string"
     },
     "language_code": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Language code (ISO 639-1) for speech generation and text normalization.",
      "title": "Language Code"
     },
     "output_format": {
      "default": "mp3_44100_128",
      "description": "Output format of the generated audio. Formatted as codec_sample_rate_bitrate.",
      "enum": [
       "mp3_22050_32",
       "mp3_44100_32",
       "mp3_44100_64",
       "mp3_44100_96",
       "mp3_44100_128",
       "mp3_44100_192",
       "pcm_8000",
       "pcm_16000",
       "pcm_22050",
       "pcm_24000",
       "pcm_44100",
       "pcm_48000",
       "ulaw_8000",
       "alaw_8000",
       "opus_48000_32",
       "opus_48000_64",
       "opus_48000_96",
       "opus_48000_128",
       "opus_48000_192"
      ],
      "title": "Output Format",
      "type": "string"
     },
     "seed": {
      "anyOf": [
       {
        "maximum": 4294967295,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "Seed for best-effort reproducibility. Identical output is not guaranteed.",
      "title": "Seed"
     },
     "similarity_boost": {
      "default": 0.75,
      "description": "How closely the output follows the reference voice. Higher values increase similarity but may reduce naturalness.",
      "maximum": 1,
      "minimum": 0,
      "title": "Similarity Boost",
      "type": "number"
     },
     "stability": {
      "default": 0.5,
      "description": "Voice stability. Lower values allow more expressive delivery; higher values make delivery more consistent.",
      "maximum": 1,
      "minimum": 0,
      "title": "Stability",
      "type": "number"
     },
     "text": {
      "description": "The text to convert to speech. Supports audio tags such as [whispering] and IPA pronunciation enclosed in forward slashes.",
      "examples": [
       "[excited] Hello! Welcome to Eleven v4."
      ],
      "maxLength": 5000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
     },
     "timestamps": {
      "default": false,
      "description": "Whether to return character-level timing information with the generated audio.",
      "title": "Timestamps",
      "type": "boolean"
     },
     "voice": {
      "default": "Rachel",
      "description": "The voice to use for speech generation",
      "examples": [
       "Aria",
       "Roger",
       "Sarah",
       "Laura",
       "Charlie",
       "George",
       "Callum",
       "River",
       "Liam",
       "Charlotte",
       "Alice",
       "Matilda",
       "Will",
       "Jessica",
       "Eric",
       "Chris",
       "Brian",
       "Daniel",
       "Lily",
       "Bill"
      ],
      "title": "Voice",
      "type": "string"
     }
    },
    "required": [
     "text"
    ],
    "title": "TextToSpeechRequestV4",
    "type": "object",
    "x-fal-order-properties": [
     "text",
     "voice",
     "stability",
     "similarity_boost",
     "seed",
     "language_code",
     "output_format",
     "apply_text_normalization",
     "timestamps"
    ]
   },
   "TtsElevenV4Output": {
    "properties": {
     "audio": {
      "$ref": "#/components/schemas/File",
      "description": "The generated audio file",
      "examples": [
       {
        "url": "https://v3.fal.media/files/zebra/zJL_oRY8h5RWwjoK1w7tx_output.mp3"
       }
      ]
     },
     "timestamps": {
      "anyOf": [
       {
        "items": {},
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "description": "Timestamps for each word in the generated speech. Only returned if `timestamps` is set to True in the request.",
      "title": "Timestamps"
     }
    },
    "required": [
     "audio"
    ],
    "title": "TTSOutput",
    "type": "object",
    "x-fal-order-properties": [
     "audio",
     "timestamps"
    ]
   }
  },
  "securitySchemes": {
   "apiKeyAuth": {
    "description": "Fal Key",
    "in": "header",
    "name": "Authorization",
    "type": "apiKey"
   }
